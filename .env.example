# CampusCore Docker Compose environment example.
# Copy to .env for local development only. Never commit real production secrets.

ASPNETCORE_ENVIRONMENT=Development

POSTGRES_DB=campuscore
POSTGRES_USER=campuscore
POSTGRES_PASSWORD=replace-with-local-password

CAMPUSCORE_JWT_ISSUER=CampusCore
CAMPUSCORE_JWT_AUDIENCE=CampusCore.Web
CAMPUSCORE_JWT_KEY=replace-with-at-least-32-random-characters
CAMPUSCORE_BOOTSTRAP_KEY=replace-with-a-random-bootstrap-key
CAMPUSCORE_ALLOWED_HOSTS=localhost;127.0.0.1
CAMPUSCORE_VERSION=0.2.0

# Browser development and Capacitor native-webview origins allowed to call the API.
# Production CORS values must be HTTPS origins without paths, queries, or fragments.
CAMPUSCORE_CORS_ORIGIN_0=http://localhost:5173
CAMPUSCORE_CORS_ORIGIN_1=https://localhost

# Host exposure defaults remain loopback-only when these are omitted.
CAMPUSCORE_DB_BIND=127.0.0.1
CAMPUSCORE_DB_PORT=5432
CAMPUSCORE_API_BIND=127.0.0.1
CAMPUSCORE_API_PORT=5080
CAMPUSCORE_WEB_BIND=127.0.0.1
CAMPUSCORE_WEB_PORT=8081
