{
  "name": "@campuscore/web",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:android": "node scripts/validate-android-env.mjs && tsc -b && vite build --mode android",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:fullstack": "playwright test --config playwright.fullstack.config.ts",
    "budget": "node scripts/check-bundle-budget.mjs",
    "verify:release": "node scripts/check-release-dist.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build && npm run budget",
    "android:init": "npm run build:android && npx cap add android",
    "android:sync": "npm run build:android && npx cap sync android",
    "android:open": "npx cap open android",
    "android:doctor": "npx cap doctor"
  },
  "dependencies": {
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@capacitor/android": "8.5.0",
    "@capacitor/cli": "8.5.0",
    "@eslint/js": "10.8.1",
    "@playwright/test": "1.62.1",
    "@types/node": "24.3.0",
    "@types/react": "19.1.11",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "eslint": "10.8.1",
    "globals": "17.11.0",
    "typescript": "7.0.2",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
